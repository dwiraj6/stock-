# Copy to .env.local and fill in. Never commit .env.local.

# ── required ─────────────────────────────────────────────────────
MONGODB_URI="mongodb+srv://<user>:<password>@<cluster>/plumbline?appName=stock"
GEMINI_API_KEY=""
TWELVEDATA_API_KEY=""

# ── auth (optional) ──────────────────────────────────────────────
# Everything below is optional. Without it the app still runs and
# every page works; only signing in is unavailable, and the UI says
# so rather than failing silently.

# Google sign-in.
#   Google Cloud Console -> APIs & Services -> Credentials
#   -> Create credentials -> OAuth client ID -> Web application
#   Authorised redirect URI (must match EXACTLY, including scheme):
#     http://localhost:3000/api/auth/google/callback
#   Add your deployed URL as a second redirect URI when you ship.
# Leave blank and the Google button hides itself.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Google sign-in via Firebase — the path that actually works without
# hand-configuring Google's OAuth consent screen, because enabling
# Google in the Firebase console provisions that screen for you.
#   Firebase console -> Authentication -> Sign-in method -> Google
#   -> Enable, set a project support email
#   Authentication -> Settings -> Authorised domains -> add your host
#   Project settings -> Your apps -> Web -> copy these three values
#
# NEXT_PUBLIC_ is correct here and these are not secrets: a Firebase
# web API key is a public project identifier, not a credential. What
# protects the project is the authorised-domain list plus this app
# verifying every ID token server-side against Google's JWKS.
#
# Leave blank and the Google button falls back to the direct OAuth
# implementation in lib/google.ts, or hides itself if that is unset too.
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=""
NEXT_PUBLIC_FIREBASE_PROJECT_ID=""

# Email, for the 6-digit verification codes. Plain SMTP, so any
# provider works.
#
# Gmail is the least friction and, unlike the free tier of most
# transactional providers, it will deliver to ANY address rather than
# only your own verified one:
#   1. Turn on 2-Step Verification on the Google account
#   2. Google Account -> Security -> App passwords -> generate one
#   3. SMTP_USER is the full gmail address, SMTP_PASS is the
#      16-character app password (spaces are fine, they get stripped)
#
# Leave blank and signup will tell the user email is not configured
# instead of pretending a code was sent.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="stockshishya <no-reply@stockshishya.app>"
